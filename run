#!/usr/bin/env bash
# Life Gamify — Unified Run Dispatcher
# Usage: ./run [ios|android|web]

set -eo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$ROOT_DIR/scripts/orchestrator.sh"

TARGET="${1:-web}"

case "$TARGET" in
  web)
    log_info "Starting Life Gamify Web in Development Mode..."
    cd "$ROOT_DIR"
    npm run dev
    ;;

  ios)
    log_info "Starting iOS App & Live Dev Server..."
    "$ROOT_DIR/scripts/run-ios.sh"
    ;;

  android)
    log_info "Starting Android App & Live Dev Server..."
    "$ROOT_DIR/scripts/run-android.sh"
    ;;

  *)
    echo -e "${RED}Unknown target: $TARGET${RESET}"
    echo "Usage: ./run [ios|android|web]"
    exit 1
    ;;
esac
